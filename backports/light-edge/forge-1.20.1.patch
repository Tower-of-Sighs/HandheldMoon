@@ -0,0 +1,60 @@
+package com.sighs.handheldmoon.mixin;
+
+import com.sighs.handheldmoon.dynamiclight.BeamEdgeLighting;
+import toni.sodiumdynamiclights.SodiumDynamicLights;
+import toni.sodiumdynamiclights.DynamicLightSource;
+import java.util.Set;
+import java.util.concurrent.locks.ReentrantReadWriteLock;
+import org.spongepowered.asm.mixin.Final;
+import org.spongepowered.asm.mixin.Shadow;
+import net.minecraft.core.BlockPos;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+/** Filters the common light query used by both vanilla and Sodium/Embeddium. */
+@Mixin(value = SodiumDynamicLights.class, remap = false)
+public abstract class BeamEdgeLightingMixin {
+    @Shadow @Final private Set<DynamicLightSource> dynamicLightSources;
+    @Shadow @Final private ReentrantReadWriteLock lightSourcesLock;
+
+    // Mesh workers query concurrently. Neighbour reads must bypass this filter
+    // so that the taper is applied once and never feeds back into itself.
+    @Unique
+    private final ThreadLocal<Boolean> handheldmoon$rawSample = ThreadLocal.withInitial(() -> false);
+
+    @Inject(method = "getDynamicLightLevel", at = @At("RETURN"), cancellable = true)
+    private void handheldmoon$smoothBeamEdge(BlockPos pos, CallbackInfoReturnable<Double> cir) {
+        if (handheldmoon$rawSample.get() || SodiumDynamicLights.get().getLightSourcesCount() == 0) return;
+        double center = cir.getReturnValueD();
+        int px = pos.getX(), py = pos.getY(), pz = pos.getZ();
+        if (!SodiumDynamicLights.get().config.getDynamicLightsMode().isEnabled()) return;
+        lightSourcesLock.readLock().lock();
+        try {
+            if (!handheldmoon$hasSourcesNear(px, py, pz)) return;
+            handheldmoon$rawSample.set(true);
+            SodiumDynamicLights engine = (SodiumDynamicLights) (Object) this;
+            int packed = BeamEdgeLighting.apply(px, py, pz, 0, (x, y, z) ->
+                    x == px && y == py && z == pz ? center
+                            : engine.getDynamicLightLevel(new BlockPos(x, y, z)));
+            cir.setReturnValue((packed & 0xFFFF) / 16.0);
+        } finally {
+            handheldmoon$rawSample.set(false);
+            lightSourcesLock.readLock().unlock();
+        }
+    }
+
+    @Unique
+    private boolean handheldmoon$hasSourcesNear(int x, int y, int z) {
+        // This branch's largest light radius is 32; include the donor halo.
+        for (DynamicLightSource source : dynamicLightSources) {
+            if (source.sdl$getLuminance() > 0
+                    && Math.abs(x + 0.5 - source.sdl$getDynamicLightX()) <= 33
+                    && Math.abs(y + 0.5 - source.sdl$getDynamicLightY()) <= 33
+                    && Math.abs(z + 0.5 - source.sdl$getDynamicLightZ()) <= 33) return true;
+        }
+        return false;
+    }
+}
